# Server Configuration
PORT=8090
ENV=local
FRONTEND_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
LOG_LEVEL=debug

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=humora_db
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & JWT
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY_MIN=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
PASSWORD_SECRET=your-secret-salt-key

# MinIO Object Storage Configuration
STORAGE_DRIVER=minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_DEFAULT_BUCKET=paylogic-media
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000

# Telegram Alert (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Biometric Facial Recognition Engine (MobileFaceNet ONNX)
MOBILEFACENET_MODEL_PATH=configs/models/mobilefacenet.onnx
