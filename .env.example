# Master Host Configuration
# Set APP_HOST (or HOST) to your machine IP, private LAN IP, or domain.
# All services (Frontend, CORS, MinIO public URLs, OAuth) will automatically adapt.
APP_HOST=192.168.1.5
HOST=192.168.1.5

# Server Configuration
PORT=8090
ENV=local
FRONTEND_BASE_URL=http://192.168.1.5:3000
ALLOWED_ORIGINS=http://192.168.1.5:3000,http://192.168.1.5:5173,http://192.168.1.5:8090,http://192.168.1.5:8000,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
LOG_LEVEL=debug
# Behind a reverse proxy: header carrying the client IP, and the proxy CIDRs allowed to set it.
PROXY_HEADER=
TRUSTED_PROXIES=
# Write raw face crops to storage/debug_biometrics (local debugging only; biometric PII).
BIOMETRIC_DEBUG_DUMP=false

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=humora_db
DB_SSLMODE=disable

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security & JWT
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY_MIN=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
PASSWORD_SECRET=your-secret-salt-key

# MinIO Object Storage Configuration
STORAGE_DRIVER=minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_DEFAULT_BUCKET=paylogic-media
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://192.168.1.5:9000

# Pulse push notifications (optional): a Firebase service account with the "Firebase Cloud Messaging
# API Admin" role. Set one of these; leave both empty to run without push.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=

# Telegram Alert (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI Biometric Facial Recognition Engine (MobileFaceNet ONNX)
MOBILEFACENET_MODEL_PATH=configs/models/mobilefacenet.onnx

# Social Login OAuth (Optional - Leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8090
