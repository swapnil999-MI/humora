# Copy to .env.production and fill in. The server refuses to start in production if any
# required secret is missing or still a default value.

ENV=production
FRONTEND_BASE_URL=https://hr.example.com
ALLOWED_ORIGINS=https://hr.example.com
LOG_LEVEL=info

# Registering an organization makes the caller its superadmin, so only the first
# organization can sign up on a fresh server. Set true only for a public multi-tenant SaaS.
PUBLIC_SIGNUP=false
# Tenant SMTP hosts on private/loopback networks are refused (the SMTP test could otherwise
# probe internal services). Set true only if you relay mail through an internal server.
SMTP_ALLOW_PRIVATE_HOSTS=false

# openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRY_MIN=30
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30
# Encrypts stored SMTP/identity secrets. Changing it makes existing encrypted values unreadable.
PASSWORD_SECRET=

DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=humora
DB_SSLMODE=require

REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

STORAGE_DRIVER=minio
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=true
MINIO_DEFAULT_BUCKET=humora-media
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=
PULSE_MEDIA_BUCKET=pulse-media

# Pulse push notifications (optional; see README "Push notifications")
FCM_SERVICE_ACCOUNT_JSON=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=https://hr.example.com

# IPs/CIDRs of a TLS proxy or load balancer in front of the web container, if any.
# Leave empty when clients connect directly (never a range clients can come from).
WEB_TRUSTED_PROXIES=
